# Server
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sensor_db
DB_USER=postgres
DB_PASSWORD=your_password

# CORS — set this to your Next.js frontend URL
FRONTEND_URL=http://localhost:3000

# API Key — ESP32 must send this in the X-API-Key header
API_KEY=your_secret_esp32_api_key
